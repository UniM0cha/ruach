# Ruach — 환경 변수 (.env로 복사 후 채우기)

# OpenAI API 키. 백엔드에서만 사용되며 브라우저로 절대 내려가지 않는다.
OPENAI_API_KEY=sk-...

# Realtime 모델. 기본 gpt-realtime-2.
# 날짜 고정 버전 예시: gpt-realtime-2025-08-28
RUACH_REALTIME_MODEL=gpt-realtime-2

# 음성. 문서 예시는 alloy. gpt-realtime 계열은 marin/cedar 등 더 자연스러운 보이스도
# 지원할 수 있으므로 web 클라이언트 붙일 때 사용 가능 목록을 확정한다.
RUACH_VOICE=alloy

# 단기 토큰 만료(초). 10~7200, 기본 600.
RUACH_TOKEN_TTL_SECONDS=600

# 백엔드 포트
PORT=8787
